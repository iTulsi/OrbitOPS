# Copy this file to backend/.env for local backend development.

# OrbitOPS runtime environment: development, test, or production
ORBITOPS_ENV=development

# OrbitOPS server configuration
PORT=5050
WEB_CONCURRENCY=1

# Development may leave this blank and use a local-only default.
# Production requires a unique secret containing at least 32 characters.
SECRET_KEY=

# Add the real value only inside your local backend/.env file.
GEMINI_API_KEY=

# Comma-separated frontend origins allowed to call the API.
# Production requires explicit http:// or https:// origins and rejects "*".
CORS_ALLOWED_ORIGINS=http://localhost:5050,http://localhost:5173
